meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{host}}:{{port}}/api/login
  body: multipartForm
  auth: none
}

body:multipart-form {
  email: jgoyette@example.net
  password: password
}

script:post-response {
  const bearerToken = res.body.data.token;
  bru.setEnvVar('bearerToken', bearerToken);
}
